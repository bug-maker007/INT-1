# AGRESSIVE_FINAL: all rules in one file for the most complete detection when analysing a dump
# (Mythic C2 v3.4.36, HTTP C2 Profile, agent Medusa). Same rules as prod + aggressive + lab_ioc, no duplicates.
# Requires: ja4-fingerprints: yes in suricata.yaml. Rule 9200024 (entropy) loads only on Suricata 8+,
# Suricata 7 skips it and loads the rest. The LAB IOC section contains test domains and UUIDs of the
# lab stand: fine for analysing these dumps, do not deploy on production sensors.

# ===== prod/prod_http.rules =====
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic Medusa agent task polling over HTTP GET (python header order, Mythic message in query parameter)"; flow:established,to_server; http.method; content:"GET"; http.header_names; content:"|0d 0a|Accept-Encoding|0d 0a|Host|0d 0a|User-Agent|0d 0a|Connection|0d 0a 0d 0a|"; startswith; endswith; fast_pattern; http.accept_enc; content:"identity"; bsize:8; http.user_agent; content:!"Python-urllib"; http.uri; content:"="; pcre:"/[?&][^=&]{1,32}=[MNOYZ][A-Za-z0-9_-]{10}t[A-Za-z0-9_-]{6}0[A-Za-z0-9_-]{5}L[TW][A-Za-z0-9_-]{5}t/"; threshold:type limit, track by_src, count 1, seconds 300; classtype:trojan-activity; sid:9100001; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset prod_http;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic Medusa agent sending data over HTTP POST (python header order, Mythic message in body)"; flow:established,to_server; http.method; content:"POST"; http.header_names; content:"|0d 0a|Accept-Encoding|0d 0a|Content-Type|0d 0a|Content-Length|0d 0a|Host|0d 0a|User-Agent|0d 0a|Connection|0d 0a 0d 0a|"; startswith; endswith; fast_pattern; http.accept_enc; content:"identity"; bsize:8; http.request_body; content:"t"; offset:11; depth:1; content:"0"; offset:18; depth:1; content:"L"; offset:24; depth:1; content:"t"; offset:31; depth:1; pcre:"/^[MNOYZ][A-Za-z0-9+\/]{10}t[A-Za-z0-9+\/]{6}0[A-Za-z0-9+\/]{5}L[TW][A-Za-z0-9+\/]{5}t/"; threshold:type limit, track by_src, count 1, seconds 300; classtype:trojan-activity; sid:9100002; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset prod_http;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic agent with default HTTP profile polling tasks over GET (UA IE11, /index?q= with Mythic message)"; flow:established,to_server; http.method; content:"GET"; http.user_agent; content:"Mozilla/5.0 (Windows NT 6.3|3b| Trident/7.0|3b| rv:11.0) like Gecko"; bsize:61; fast_pattern; http.uri; content:"/index?q="; startswith; pcre:"/^\/index\?q=[MNOYZ][A-Za-z0-9_-]{10}t[A-Za-z0-9_-]{6}0[A-Za-z0-9_-]{5}L[TW][A-Za-z0-9_-]{5}t/"; threshold:type limit, track by_src, count 1, seconds 300; classtype:trojan-activity; sid:9100003; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset prod_http;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic agent with default HTTP profile sending data over POST (UA IE11, /data with Mythic message)"; flow:established,to_server; http.method; content:"POST"; http.user_agent; content:"Mozilla/5.0 (Windows NT 6.3|3b| Trident/7.0|3b| rv:11.0) like Gecko"; bsize:61; fast_pattern; http.uri; content:"/data"; bsize:5; http.request_body; content:"t"; offset:11; depth:1; content:"0"; offset:18; depth:1; content:"L"; offset:24; depth:1; content:"t"; offset:31; depth:1; pcre:"/^[MNOYZ][A-Za-z0-9+\/]{10}t[A-Za-z0-9+\/]{6}0[A-Za-z0-9+\/]{5}L[TW][A-Za-z0-9+\/]{5}t/"; threshold:type limit, track by_src, count 1, seconds 300; classtype:trojan-activity; sid:9100004; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset prod_http;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"C2 Mythic server reply via HTTP profile (duplicate Content-Type headers, Mythic message in body)"; flow:established,to_client; http.stat_code; content:"200"; http.header.raw; content:"Content-Type: application/octet-stream|0d 0a|"; fast_pattern; content:"Content-Type:"; content:"Content-Type:"; distance:0; file.data; content:"t"; offset:11; depth:1; content:"0"; offset:18; depth:1; content:"L"; offset:24; depth:1; content:"t"; offset:31; depth:1; pcre:"/^[MNOYZ][A-Za-z0-9+\/]{10}t[A-Za-z0-9+\/]{6}0[A-Za-z0-9+\/]{5}L[TW][A-Za-z0-9+\/]{5}t/"; threshold:type limit, track by_dst, count 1, seconds 300; classtype:trojan-activity; sid:9100005; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset prod_http;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"C2 Mythic server reply via HTTP profile (Server NetDNA-cache/2.2, Mythic message in body)"; flow:established,to_client; http.server; content:"NetDNA-cache/2.2"; bsize:16; fast_pattern; file.data; content:"t"; offset:11; depth:1; content:"0"; offset:18; depth:1; content:"L"; offset:24; depth:1; content:"t"; offset:31; depth:1; pcre:"/^[MNOYZ][A-Za-z0-9+\/]{10}t[A-Za-z0-9+\/]{6}0[A-Za-z0-9+\/]{5}L[TW][A-Za-z0-9+\/]{5}t/"; threshold:type limit, track by_dst, count 1, seconds 300; classtype:trojan-activity; sid:9100006; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset prod_http;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic Medusa HTTP beaconing (15+ GET per minute to one host, python header order, browser UA)"; flow:established,to_server; http.method; content:"GET"; http.header_names; content:"|0d 0a|Accept-Encoding|0d 0a|Host|0d 0a|User-Agent|0d 0a|Connection|0d 0a 0d 0a|"; startswith; endswith; fast_pattern; http.accept_enc; content:"identity"; bsize:8; http.user_agent; content:"Mozilla/"; startswith; threshold:type both, track by_both, count 15, seconds 60; classtype:trojan-activity; sid:9100020; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset prod_http;)

# ===== prod/prod_https.rules =====
alert tls $EXTERNAL_NET any -> $HOME_NET any (msg:"C2 Mythic default self-signed TLS certificate (O=Mythic C2 in subject and issuer, TLS 1.2 and older)"; flow:established,to_client; tls.cert_subject; content:"O=Mythic"; fast_pattern; tls.cert_issuer; content:"O=Mythic"; threshold:type limit, track by_dst, count 1, seconds 300; classtype:trojan-activity; sid:9100007; rev:4; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset prod_https;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic Medusa HTTPS beaconing (15+ TLS sessions per minute to one host, client without ALPN)"; flow:established,to_server; ja4.hash; content:"t"; startswith; content:"00_"; offset:8; depth:3; fast_pattern; threshold:type both, track by_both, count 15, seconds 60; classtype:trojan-activity; sid:9100021; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset prod_https;)

# ===== aggressive/aggressive_http.rules =====
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"C2 Mythic possible server reply via HTTP profile (Server NetDNA-cache/2.2 banner only)"; flow:established,to_client; http.server; content:"NetDNA-cache/2.2"; bsize:16; fast_pattern; classtype:trojan-activity; sid:9200006; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_http;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic message from any agent in HTTP POST body (base64 UUID4 prefix)"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"t"; offset:11; depth:1; content:"0"; offset:18; depth:1; content:"L"; offset:24; depth:1; content:"t"; offset:31; depth:1; pcre:"/^[MNOYZ][A-Za-z0-9+\/_-]{10}t[A-Za-z0-9+\/_-]{6}0[A-Za-z0-9+\/_-]{5}L[TW][A-Za-z0-9+\/_-]{5}t/"; classtype:trojan-activity; sid:9200010; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_http;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic message from any agent in HTTP query parameter (base64 UUID4 prefix)"; flow:established,to_server; http.uri; content:"="; pcre:"/[?&][^=&]{1,32}=[MNOYZ][A-Za-z0-9+\/_-]{10}t[A-Za-z0-9+\/_-]{6}0[A-Za-z0-9+\/_-]{5}L[TW][A-Za-z0-9+\/_-]{5}t/"; classtype:trojan-activity; sid:9200011; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_http;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"C2 Mythic message from server in HTTP reply body (base64 UUID4 prefix)"; flow:established,to_client; file.data; content:"t"; offset:11; depth:1; content:"0"; offset:18; depth:1; content:"L"; offset:24; depth:1; content:"t"; offset:31; depth:1; pcre:"/^[MNOYZ][A-Za-z0-9+\/_-]{10}t[A-Za-z0-9+\/_-]{6}0[A-Za-z0-9+\/_-]{5}L[TW][A-Za-z0-9+\/_-]{5}t/"; classtype:trojan-activity; sid:9200015; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_http;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic possible Medusa HTTP client (browser UA with python http.client header order)"; flow:established,to_server; http.header_names; content:"|0d 0a|Accept-Encoding|0d 0a|"; startswith; content:"|0d 0a|Host|0d 0a|User-Agent|0d 0a|Connection|0d 0a 0d 0a|"; endswith; http.accept_enc; content:"identity"; bsize:8; http.user_agent; content:"Mozilla/"; startswith; classtype:trojan-activity; sid:9200020; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_http;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic Medusa HTTP beaconing (5+ GET per minute to one host, python header order)"; flow:established,to_server; http.method; content:"GET"; http.header_names; content:"|0d 0a|Accept-Encoding|0d 0a|Host|0d 0a|User-Agent|0d 0a|Connection|0d 0a 0d 0a|"; startswith; endswith; fast_pattern; http.user_agent; content:!"Python-urllib"; threshold:type threshold, track by_both, count 5, seconds 60; classtype:trojan-activity; sid:9200021; rev:4; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_http;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic Medusa slow HTTP beaconing (20+ GET per 10 minutes to one host, python header order)"; flow:established,to_server; http.method; content:"GET"; http.header_names; content:"|0d 0a|Accept-Encoding|0d 0a|Host|0d 0a|User-Agent|0d 0a|Connection|0d 0a 0d 0a|"; startswith; endswith; fast_pattern; http.user_agent; content:!"Python-urllib"; threshold:type both, track by_both, count 20, seconds 600; classtype:trojan-activity; sid:9200025; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_http;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic HTTP beaconing from any agent (5+ GET per minute to one host with Mythic message in query)"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"="; pcre:"/[?&][^=&]{1,32}=[MNOYZ][A-Za-z0-9+\/_-]{10}t[A-Za-z0-9+\/_-]{6}0[A-Za-z0-9+\/_-]{5}L[TW][A-Za-z0-9+\/_-]{5}t/"; threshold:type both, track by_both, count 5, seconds 60; classtype:trojan-activity; sid:9200026; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_http;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic Medusa file transfer to C2 over HTTP POST (5+ POST of 50000+ bytes per minute, python header order)"; flow:established,to_server; http.method; content:"POST"; http.header_names; content:"|0d 0a|Accept-Encoding|0d 0a|Content-Type|0d 0a|Content-Length|0d 0a|"; startswith; http.content_len; byte_test:0,>=,50000,0,string,dec; threshold:type threshold, track by_src, count 5, seconds 60; classtype:trojan-activity; sid:9200022; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_http;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic possible message in HTTP GET query (base64url value 120+ chars, 3+ per 5 minutes)"; flow:established,to_server; http.method; content:"GET"; http.uri; bsize:>150; pcre:"/[?&][A-Za-z0-9_\-]{1,16}=(?=[A-Za-z0-9_\-]*[A-Z])(?=[A-Za-z0-9_\-]*[a-z])(?=[A-Za-z0-9_\-]*[0-9])[A-Za-z0-9_\-]{120,}(?:&|$)/"; threshold:type both, track by_src, count 3, seconds 300; classtype:trojan-activity; sid:9200023; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_http;)

# ===== aggressive/aggressive_http_s8.rules =====
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic possible message in HTTP GET query (URI entropy above 5.3 bits per byte, 3+ per 5 minutes)"; flow:established,to_server; http.method; content:"GET"; http.uri; bsize:>150; content:"?"; pcre:"/[?&][A-Za-z0-9_\-]{1,16}=[A-Za-z0-9_\-]{120,}(?:&|$)/"; entropy: value > 5.3; threshold:type both, track by_src, count 3, seconds 300; classtype:trojan-activity; sid:9200024; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_http;)

# ===== aggressive/aggressive_https.rules =====
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic Medusa HTTPS beaconing (5+ TLS sessions per minute to one host, client without ALPN)"; flow:established,to_server; ja4.hash; content:"t"; startswith; content:"00_"; offset:8; depth:3; fast_pattern; threshold:type threshold, track by_both, count 5, seconds 60; priority:3; classtype:trojan-activity; sid:9200030; rev:4; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_https;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic Medusa slow HTTPS beaconing (20+ TLS sessions per 10 minutes to one host, client without ALPN)"; flow:established,to_server; ja4.hash; content:"t"; startswith; content:"00_"; offset:8; depth:3; fast_pattern; threshold:type both, track by_both, count 20, seconds 600; priority:3; classtype:trojan-activity; sid:9200032; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_https;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic Medusa HTTPS beaconing from Debian 13 python3 (JA4 t13d301200_1d37bd780c83_ecd0401ec68b, 20+ per 2 minutes)"; flow:established,to_server; ja4.hash; content:"t13d301200_1d37bd780c83_ecd0401ec68b"; threshold:type threshold, track by_both, count 20, seconds 120; priority:3; classtype:trojan-activity; sid:9200031; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_https;)

# ===== lab_ioc/lab_ioc.rules =====
alert dns $HOME_NET any -> any any (msg:"C2 Mythic LAB IOC test C2 domain in DNS query (khenkal.net, do not deploy)"; dns.query; dotprefix; content:".khenkal.net"; nocase; endswith; threshold:type limit, track by_src, count 1, seconds 300; classtype:trojan-activity; sid:9300001; rev:1; metadata:created_at 2026_10_26, updated_at 2026_10_26, ruleset lab_ioc;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic LAB IOC test C2 domain in TLS SNI (khenkal.net, do not deploy)"; flow:established,to_server; tls.sni; dotprefix; content:".khenkal.net"; nocase; endswith; threshold:type limit, track by_src, count 1, seconds 300; classtype:trojan-activity; sid:9300002; rev:1; metadata:created_at 2026_10_26, updated_at 2026_10_26, ruleset lab_ioc;)
alert dns $HOME_NET any -> any any (msg:"C2 Mythic LAB IOC test C2 domain in DNS query (ptnad.com, do not deploy)"; dns.query; dotprefix; content:".ptnad.com"; nocase; endswith; threshold:type limit, track by_src, count 1, seconds 300; classtype:trojan-activity; sid:9300003; rev:1; metadata:created_at 2026_10_26, updated_at 2026_10_26, ruleset lab_ioc;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic LAB IOC callback UUID e13c00c5 in HTTP query (do not deploy)"; flow:established,to_server; http.uri; content:"=ZTEzYzAwYzUtY2EyNS00OGUzLTk2MmUtNGZmZmM0NDg4ZTZh"; fast_pattern; threshold:type limit, track by_src, count 1, seconds 300; classtype:trojan-activity; sid:9300004; rev:1; metadata:created_at 2026_10_26, updated_at 2026_10_26, ruleset lab_ioc;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic LAB IOC callback UUID e13c00c5 in HTTP POST body (do not deploy)"; flow:established,to_server; http.request_body; content:"ZTEzYzAwYzUtY2EyNS00OGUzLTk2MmUtNGZmZmM0NDg4ZTZh"; startswith; fast_pattern; threshold:type limit, track by_src, count 1, seconds 300; classtype:trojan-activity; sid:9300005; rev:1; metadata:created_at 2026_10_26, updated_at 2026_10_26, ruleset lab_ioc;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic LAB IOC payload UUID 07ce9c45 in HTTP check-in body (do not deploy)"; flow:established,to_server; http.request_body; content:"MDdjZTljNDUtODFmZi00YmQ2LTlkMTktODI4Mzk3MjZkMzY5"; startswith; fast_pattern; threshold:type limit, track by_src, count 1, seconds 300; classtype:trojan-activity; sid:9300006; rev:1; metadata:created_at 2026_10_26, updated_at 2026_10_26, ruleset lab_ioc;)

