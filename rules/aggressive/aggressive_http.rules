# AGGRESSIVE, HTTP. Load together with prod/prod_http.rules: contains only extra rules, no duplicates.
# Every hit alerts; more FP and load. Suricata 8: also load aggressive_http_s8.rules.
# UUID4 in base64: [0] in MNOYZ, [11]='t', [18]='0', [24]='L', [25] in TW, [31]='t' (base64 and base64url).
# Mythic C2 v3.4.36, HTTP C2 Profile, agent Medusa. Tested in Dalton on Suricata 7.0.14 and 8.0.7.

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"C2 Mythic possible server reply via HTTP profile (Server NetDNA-cache/2.2 banner only)"; flow:established,to_client; http.server; content:"NetDNA-cache/2.2"; bsize:16; fast_pattern; classtype:trojan-activity; sid:9200006; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_http;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic message from any agent in HTTP POST body (base64 UUID4 prefix)"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"t"; offset:11; depth:1; content:"0"; offset:18; depth:1; content:"L"; offset:24; depth:1; content:"t"; offset:31; depth:1; pcre:"/^[MNOYZ][A-Za-z0-9+\/_-]{10}t[A-Za-z0-9+\/_-]{6}0[A-Za-z0-9+\/_-]{5}L[TW][A-Za-z0-9+\/_-]{5}t/"; classtype:trojan-activity; sid:9200010; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_http;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic message from any agent in HTTP query parameter (base64 UUID4 prefix)"; flow:established,to_server; http.uri; content:"="; pcre:"/[?&][^=&]{1,32}=[MNOYZ][A-Za-z0-9+\/_-]{10}t[A-Za-z0-9+\/_-]{6}0[A-Za-z0-9+\/_-]{5}L[TW][A-Za-z0-9+\/_-]{5}t/"; classtype:trojan-activity; sid:9200011; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_http;)
alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"C2 Mythic message from server in HTTP reply body (base64 UUID4 prefix)"; flow:established,to_client; file.data; content:"t"; offset:11; depth:1; content:"0"; offset:18; depth:1; content:"L"; offset:24; depth:1; content:"t"; offset:31; depth:1; pcre:"/^[MNOYZ][A-Za-z0-9+\/_-]{10}t[A-Za-z0-9+\/_-]{6}0[A-Za-z0-9+\/_-]{5}L[TW][A-Za-z0-9+\/_-]{5}t/"; classtype:trojan-activity; sid:9200015; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_http;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic possible Medusa HTTP client (browser UA with python http.client header order)"; flow:established,to_server; http.header_names; content:"|0d 0a|Accept-Encoding|0d 0a|"; startswith; content:"|0d 0a|Host|0d 0a|User-Agent|0d 0a|Connection|0d 0a 0d 0a|"; endswith; http.accept_enc; content:"identity"; bsize:8; http.user_agent; content:"Mozilla/"; startswith; classtype:trojan-activity; sid:9200020; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_http;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic Medusa HTTP beaconing (5+ GET per minute to one host, python header order)"; flow:established,to_server; http.method; content:"GET"; http.header_names; content:"|0d 0a|Accept-Encoding|0d 0a|Host|0d 0a|User-Agent|0d 0a|Connection|0d 0a 0d 0a|"; startswith; endswith; fast_pattern; http.user_agent; content:!"Python-urllib"; threshold:type threshold, track by_both, count 5, seconds 60; classtype:trojan-activity; sid:9200021; rev:4; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_http;)
