# AGGRESSIVE, HTTPS without TLS inspection. Load together with prod/prod_https.rules.
# Needs ja4-fingerprints: yes. JA4/no-ALPN rules catch any python ssl client, priority 3.
# Mythic C2 v3.4.36, HTTP C2 Profile, agent Medusa. Tested in Dalton on Suricata 7.0.14 and 8.0.7.

alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic Medusa HTTPS beaconing (5+ TLS sessions per minute to one host, client without ALPN)"; flow:established,to_server; ja4.hash; content:"t"; startswith; content:"00_"; offset:8; depth:3; fast_pattern; threshold:type threshold, track by_both, count 5, seconds 60; priority:3; classtype:trojan-activity; sid:9200030; rev:4; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_https;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic Medusa slow HTTPS beaconing (20+ TLS sessions per 10 minutes to one host, client without ALPN)"; flow:established,to_server; ja4.hash; content:"t"; startswith; content:"00_"; offset:8; depth:3; fast_pattern; threshold:type both, track by_both, count 20, seconds 600; priority:3; classtype:trojan-activity; sid:9200032; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_https;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"C2 Mythic Medusa HTTPS beaconing from Debian 13 python3 (JA4 t13d301200_1d37bd780c83_ecd0401ec68b, 20+ per 2 minutes)"; flow:established,to_server; ja4.hash; content:"t13d301200_1d37bd780c83_ecd0401ec68b"; threshold:type threshold, track by_both, count 20, seconds 120; priority:3; classtype:trojan-activity; sid:9200031; rev:3; metadata:created_at 2026_10_25, updated_at 2026_10_26, ruleset aggressive_https;)
